## Isabelle/jEdit Query plugin properties
##
##:wrap=soft:maxLineLen=100:

#identification
plugin.isabelle.jedit_query_plugin.Plugin.name=Isabelle Project Query
plugin.isabelle.jedit_query_plugin.Plugin.author=David Wang, with Claude
plugin.isabelle.jedit_query_plugin.Plugin.version=0.8.0
plugin.isabelle.jedit_query_plugin.Plugin.description=Syntax-aware queries over the Isabelle project sources: find usages of a fact, without a build and without waiting for the prover.

#system parameters
plugin.isabelle.jedit_query_plugin.Plugin.activate=startup
plugin.isabelle.jedit_query_plugin.Plugin.usePluginHome=false

#option pane: a jEdit pane, not an Isabelle one, because it must be readable
#before the prover plugin exists -- the same reason the gesture table lives in
#jEdit properties.  The Isabelle side of the table is jedit_query/etc/options.
plugin.isabelle.jedit_query_plugin.Plugin.option-group=isabelle-project-query
options.isabelle-project-query.label=Project Query
options.isabelle-project-query.code=new isabelle.jedit_query_plugin.Option_Pane();

#dependencies
plugin.isabelle.jedit_query_plugin.Plugin.depend.0=plugin isabelle.jedit_main.Plugin 11.2

#menu actions and dockables
plugin.isabelle.jedit_query_plugin.Plugin.menu.label=Isabelle Project Query
plugin.isabelle.jedit_query_plugin.Plugin.menu= \
  isabelle-project-query \
  - \
  isabelle-project-query.find-usages \
  isabelle-project-query.find-external-usages \
  isabelle-project-query.find-definition \
  isabelle-project-query.find-instantiations \
  isabelle-project-query.find-code-equations \
  isabelle-project-query.peek-definition \
  isabelle-project-query.go-to-symbol \
  isabelle-project-query.search-by-name \
  - \
  isabelle-project-query.navigate-backwards \
  isabelle-project-query.navigate-forwards \
  - \
  isabelle-project-query.refresh-index

isabelle-project-query.label=Project Query panel
isabelle-project-query.title=Project Query
isabelle-project-query.dock-position=bottom

isabelle-project-query.find-usages.label=Find usages at caret
isabelle-project-query.find-external-usages.label=Find external usages at caret
isabelle-project-query.find-definition.label=Find definition at caret
#No default shortcut for either site verb: three chords are already claimed
#(CA+LEFT, CA+RIGHT, CAS+n) and a fourth and fifth would meet a real keymap for
#a verb most users reach from the right-click menu.  Both are bindable from
#Global Options -> Shortcuts.
isabelle-project-query.find-instantiations.label=Find instantiations at caret
isabelle-project-query.find-code-equations.label=Find code equations at caret
isabelle-project-query.peek-definition.label=Peek definition at caret
isabelle-project-query.go-to-symbol.label=Go to symbol
#CAS+N is IntelliJ's go-to-symbol and is unbound in jEdit's default keymap
#(CS+n is new-file-in-mode, which is why the plain chord is not used).
isabelle-project-query.go-to-symbol.shortcut=CAS+n
#Opens the panel and focuses its name field.  No default shortcut: the panel's
#own field is the affordance, and a fourth chord would meet a real keymap for
#something two clicks away.
isabelle-project-query.search-by-name.label=Search by name (panel)
isabelle-project-query.show-panel.label=Show Project Query panel
isabelle-project-query.refresh-index.label=Refresh project index

#Isabelle/jEdit already keeps the jump stacks (isabelle.jedit.Isabelle_Navigator)
#and registers navigate-backwards / navigate-forwards for them, but ships no
#label and no shortcut, so they are reachable only from the action dialog.
#These two actions drive the SAME navigator under our own names -- writing a
#.shortcut for isabelle.jedit_main's action would be a property collision with
#the next Isabelle release.  CA+LEFT / CA+RIGHT are unused by jEdit's default
#keymap (which binds no CA+ chord at all) and are the IDE convention.
isabelle-project-query.navigate-backwards.label=Navigate backwards
isabelle-project-query.navigate-backwards.shortcut=CA+LEFT
isabelle-project-query.navigate-forwards.label=Navigate forwards
isabelle-project-query.navigate-forwards.shortcut=CA+RIGHT

#result navigation: which mouse gesture opens a result where.  Values are
#none / current / new-pane / new-view / peek; `new-pane` splits the active
#view, `peek` opens a transient popup and leaves the editor where it is.
#An unrecognised value is reported in the activity log and on the status line,
#never silently defaulted.  Editable in Plugin Options -> Isabelle Project
#Query, or as the Isabelle options jedit_query_gesture_*.
#ALT rather than CTRL for peek: ctrl+click is how a JTree extends a
#discontiguous selection, which this panel uses for multi-node removal.
isabelle-project-query.gesture.single-click=none
isabelle-project-query.gesture.double-click=current
isabelle-project-query.gesture.shift-click=new-pane
isabelle-project-query.gesture.alt-click=peek
isabelle-project-query.gesture.middle-click=new-view
isabelle-project-query.gesture.enter=current

#keep earlier result sets as siblings rather than replacing them
isabelle-project-query.stack=true

#site rows: show the sort / arity / signature the SOURCE writes at each site
#(the CLI's --sorts).  Off by default -- most rows write none, and a column of
#blanks says less than no column.  Nothing here is inferred.
isabelle-project-query.sorts=false

#how many theories a project may hold before the index refuses to build it.
#The distribution's src/HOL is ~1450 and must keep working; an AFP checkout's
#own thys/ROOT is ~10000 and must not.  0 or less means no limit.
isabelle-project-query.index-limit=2000
